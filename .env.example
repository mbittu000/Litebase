DATABASE_URL="file:./data/app.db"
# For Turso / remote libSQL, use e.g.:
# DATABASE_URL="libsql://your-db-yourorg.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"
DATABASE_AUTH_TOKEN=""

# Password to unlock the studio UI
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Secret used to sign the session cookie (generate a long random string)
AUTH_SECRET="change-me-to-a-long-random-secret-min-32-chars"
